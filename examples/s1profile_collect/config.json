{
  "metadata": {
    "name": "S1 Profile Collect",
    "description": "用 vertex-edge graph 实现 chatto-bot 的「去 stage1st 收集帖子」任务(s1profile 每日收集):forum 顶点输入版块 URL → e_collect 抓最新 N 帖全部楼层按 uid 归并 → posts_pool 中间顶点 → e_enrich 补抓每人主题帖并合并进档案 JSON → profiles sink 输出。"
  },
  "vertices": [
    {
      "id": "forum",
      "settings": {"type": "source", "label": "Stage1st 版块 URL(默认 forum-157 外野)"},
      "initial_data": [
        {
          "channel": "url",
          "value": "https://stage1st.com/2b/forum-157-1.html"
        }
      ]
    },
    {
      "id": "posts_pool",
      "settings": {"type": "transform", "label": "版块楼层按 uid 归并后的中间结果"}
    },
    {
      "id": "profiles",
      "settings": {"type": "sink", "label": "每 uid 档案 JSON"}
    }
  ],
  "edges": [
    {
      "id": "e_collect",
      "source": "forum",
      "destination": "posts_pool",
      "channel": "url",
      "prompt": "",
      "model": "default",
      "pipeline": "s1profile_collect.py",
      "settings": {
        "stage": "collect",
        "url": "https://stage1st.com/2b/forum-157-1.html",
        "max_threads": 3
      }
    },
    {
      "id": "e_enrich",
      "source": "posts_pool",
      "destination": "profiles",
      "channel": "url",
      "prompt": "",
      "model": "default",
      "pipeline": "s1profile_collect.py",
      "settings": {
        "stage": "enrich",
        "url": "https://stage1st.com/2b/forum-157-1.html",
        "max_own_threads": 3,
        "profile_dir": ""
      }
    }
  ]
}

{
  "metadata": {
    "name": "Simple Pipeline",
    "description": "Linear 3-vertex pipeline: input → processor → output"
  },
  "vertices": [
    {
      "id": "input",
      "settings": {
        "type": "source"
      },
      "initial_data": [
        {
          "channel": "text",
          "value": "Hello, this is a test message for the vertex-edge agent framework."
        }
      ]
    },
    {
      "id": "processor",
      "settings": {
        "type": "transform"
      }
    },
    {
      "id": "output",
      "settings": {
        "type": "sink"
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "input",
      "destination": "processor",
      "channel": "text",
      "settings": {
        "prompt": "Summarize the following text in one sentence:",
        "model": "gemini-pro"
      }
    },
    {
      "id": "e2",
      "source": "processor",
      "destination": "output",
      "channel": "text",
      "settings": {
        "prompt": "Translate the following to French:",
        "model": "gemini-flash"
      }
    }
  ]
}
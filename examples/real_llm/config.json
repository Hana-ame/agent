{
  "metadata": {
    "name": "Real LLM Edge Pipeline",
    "description": "Real LLM call with a transport HTTP proxy set in graph.json (https_proxy overrides any env HTTP_PROXY/HTTPS_PROXY)."
  },
  "vertices": [
    {
      "id": "user_input",
      "settings": {
        "type": "source"
      },
      "initial_data": [
        {
          "channel": "text",
          "value": "Please write a short haiku about artificial intelligence."
        }
      ]
    },
    {
      "id": "llm_output",
      "settings": {
        "type": "sink"
      }
    }
  ],
  "edges": [
    {
      "id": "e_real_llm",
      "source": "user_input",
      "destination": "llm_output",
      "channel": "text",
      "settings": {
        "prompt": "You are a creative poet.",
        "model": "hy3-free",
        "agent": {
          "type": "http",
          "base_url": "https://opencode.ai/zen/v1",
          "https_proxy": "http://127.0.1.6:7890"
        }
      }
    }
  ]
}
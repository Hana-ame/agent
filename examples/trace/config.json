{
  "metadata": {
    "name": "Trace Pipeline",
    "description": "4 vertices, 4 edges. Multiple edges point to the same merge vertex (fan-in), slotted by edge ID + tags. Edge model is global (opencode-zen/hy3-free)."
  },
  "vertices": [
    {
      "id": "source",
      "settings": {},
      "initial_data": [
        { "value": "The vertex-edge framework lets you compose AI pipelines as a graph." }
      ]
    },
    {
      "id": "summary",
      "settings": {}
    },
    {
      "id": "merge",
      "settings": {},
      "script": "scripts/merge_on_ready.py"
    },
    {
      "id": "report",
      "settings": {}
    }
  ],
  "edges": [
    {
      "id": "summarize",
      "source": "source",
      "destination": "summary",
      "prompt": "Summarize the text:",
      "model": "opencode-zen/hy3-free",
      "set_tags": ["en"]
    },
    {
      "id": "to_french",
      "source": "summary",
      "destination": "merge",
      "prompt": "Translate to French:",
      "model": "opencode-zen/hy3-free",
      "read_tags": ["en"],
      "set_tags": ["fr"]
    },
    {
      "id": "to_spanish",
      "source": "summary",
      "destination": "merge",
      "prompt": "Translate to Spanish:",
      "model": "opencode-zen/hy3-free",
      "read_tags": ["en"],
      "set_tags": ["es"]
    },
    {
      "id": "digest",
      "source": "merge",
      "destination": "report",
      "prompt": "Produce final report:",
      "model": "opencode-zen/hy3-free",
      "set_tags": ["final"]
    }
  ]
}

{
  "name": "v9_cycle",
  "_comment": "一个 v9 推理周期：两路 http 并行 → v7 图生成 → script 校验入库。",
  "seed_tag": "a",
  "result_tag": "commit_result",
  "edges": [
    {
      "id": "get_a",
      "kind": "http",
      "input_tags": [
        "url_a"
      ],
      "output_tags": [
        "ev_a"
      ],
      "url": "{tag:url_a}",
      "headers": {
        "User-Agent": "v9-cycle/1.0"
      },
      "max_chars": 4000
    },
    {
      "id": "get_b",
      "kind": "http",
      "input_tags": [
        "url_b"
      ],
      "output_tags": [
        "ev_b"
      ],
      "url": "{tag:url_b}",
      "headers": {
        "User-Agent": "v9-cycle/1.0"
      },
      "max_chars": 4000
    },
    {
      "id": "gen",
      "kind": "graph",
      "layer": 1,
      "input_tags": [
        "ev_a",
        "ev_b"
      ],
      "output_tags": [
        "claim_json"
      ],
      "graph": {
        "path": "../graphs/relation.json",
        "seed_tag": "task",
        "result_tag": "claim",
        "timeout": 240
      },
      "expect": {
        "type": "json",
        "schema": {
          "type": "object",
          "properties": {
            "relation": {
              "type": "string"
            },
            "statement": {
              "type": "string"
            },
            "confidence": {
              "type": "number"
            },
            "evidence_url": {
              "type": "string"
            }
          },
          "required": [
            "relation",
            "statement",
            "confidence",
            "evidence_url"
          ]
        }
      }
    },
    {
      "id": "commit",
      "kind": "script",
      "layer": 2,
      "input_tags": [
        "claim_json",
        "a",
        "b",
        "url_a",
        "url_b",
        "ev_a",
        "ev_b"
      ],
      "output_tags": [
        "commit_result"
      ],
      "script": "../scripts/commit.py",
      "timeout": 60,
      "expect": {
        "type": "json",
        "required_keys": [
          "status"
        ]
      }
    }
  ],
  "extra_seed_tags": [
    "b",
    "url_a",
    "url_b"
  ]
}
{
  "title": "v7 / v8 / v9 接口规范",
  "version": "2fd27e3",
  "updated": "2026-10-27",
  "summary": "v7 是 DAG 本体，v8 是执行/组织层，v9 是知识推理层。当前策略：契约保留、缓存关闭、只存知识、输出不设字数上限。",
  "policies": [
    {
      "key": "缓存",
      "value": "关闭",
      "note": "v9 executor use_cache=False；示例不加 --cache"
    },
    {
      "key": "字数",
      "value": "无硬上限",
      "note": "输出/提示词不设长度；HTTP 响应截断仅作技术保护"
    },
    {
      "key": "知识",
      "value": "只存知识",
      "note": "claims / sources / explored；v8 轨迹只调试"
    },
    {
      "key": "契约",
      "value": "保留",
      "note": "格式 / JSON / 来源；不设 min_chars / max_chars"
    }
  ],
  "columns": [
    {
      "key": "layer",
      "label": "层"
    },
    {
      "key": "type",
      "label": "类型"
    },
    {
      "key": "name",
      "label": "接口"
    },
    {
      "key": "input",
      "label": "输入"
    },
    {
      "key": "output",
      "label": "输出"
    },
    {
      "key": "notes",
      "label": "说明"
    }
  ],
  "rows": [
    {
      "id": "v7.load",
      "layer": "v7",
      "type": "Python",
      "name": "v7.load(source, *, preset_edge=None, llm_client=None)",
      "input": "路径 / dict",
      "output": "DAG 实例",
      "notes": "加载标签图；v7 是 DAG 本体。"
    },
    {
      "id": "v7.step",
      "layer": "v7",
      "type": "Python",
      "name": "v7.step()",
      "input": "无",
      "output": "推进一条就绪边",
      "notes": "卡住时由脚本处理，再 set() 继续。"
    },
    {
      "id": "v7.contents",
      "layer": "v7",
      "type": "Python",
      "name": "v7.contents / v7.get_result(tag)",
      "input": "tag（可选）",
      "output": "ContentItem 列表 / 内容",
      "notes": "每项含 tags、content、gen。"
    },
    {
      "id": "v7.set",
      "layer": "v7",
      "type": "Python",
      "name": "v7.set(tag, content)",
      "input": "tag, content",
      "output": "写入内容池",
      "notes": "外部处理结果回填。"
    },
    {
      "id": "v7.graph",
      "layer": "v7",
      "type": "JSON",
      "name": "V7 图配置",
      "input": "models + contents + edges",
      "output": "v7 DAG",
      "notes": "edge: input_tags / output_tags / processor / layer。"
    },
    {
      "id": "v8.cli.run",
      "layer": "v8",
      "type": "CLI",
      "name": "python -m dag8 run <config> [flags]",
      "input": "DAG 配置路径",
      "output": "RunResult / --json",
      "notes": "--workers / --rpm / --max-seconds / --keep-going / --adaptive。"
    },
    {
      "id": "v8.cli.lint",
      "layer": "v8",
      "type": "CLI",
      "name": "python -m dag8 lint <config>",
      "input": "DAG 配置路径",
      "output": "errors / warnings / exit code",
      "notes": "先 lint，再 dry-run。"
    },
    {
      "id": "v8.cli.trace",
      "layer": "v8",
      "type": "CLI",
      "name": "python -m dag8 runs / show / explain",
      "input": "run_id, --db",
      "output": "轨迹 / 诊断",
      "notes": "SQLite 只作调试轨迹。"
    },
    {
      "id": "v8.run",
      "layer": "v8",
      "type": "Python",
      "name": "dag8.run(config, *, seed_content=None, extra_seeds=None, db_path=None, max_workers=1, rpm=None, use_cache=False, ...)",
      "input": "配置 + seeds",
      "output": "RunResult",
      "notes": "extra_seeds 用于多 tag 注入。"
    },
    {
      "id": "v8.dag.config",
      "layer": "v8",
      "type": "JSON",
      "name": "DAG 根配置",
      "input": "name, seed_tag, seed_content, extra_seed_tags, result_tag, pi, edges",
      "output": "可执行 DAG",
      "notes": "extra_seed_tags 声明调用方注入的 tag。"
    },
    {
      "id": "v8.edge",
      "layer": "v8",
      "type": "JSON",
      "name": "Edge 配置",
      "input": "id, kind, input_tags, output_tags, prompt/script/http/db/graph, when, join, expect, judge, approval, timeout",
      "output": "一条边",
      "notes": "join: all | any；approval 是边级闸门。"
    },
    {
      "id": "v8.script",
      "layer": "v8",
      "type": "进程",
      "name": "script 节点协议",
      "input": "DAG8_INPUTS 环境变量 + stdin JSON",
      "output": "stdout；非 0 退出 = 失败",
      "notes": "tag → 内容字符串；脚本路径相对配置目录。"
    },
    {
      "id": "v8.graph",
      "layer": "v8",
      "type": "节点",
      "name": "graph 节点",
      "input": "graph.path / seed_tag / result_tag / timeout",
      "output": "v7 图的输出",
      "notes": "v8 组织层调用 v7 本体。"
    },
    {
      "id": "v8.httpdb",
      "layer": "v8",
      "type": "节点",
      "name": "http / db 节点",
      "input": "url/headers 或 db_path/query",
      "output": "文本 / 查询结果",
      "notes": "http 默认有响应截断（技术保护，不是生成字数限制）。"
    },
    {
      "id": "v8.expect",
      "layer": "v8",
      "type": "契约",
      "name": "expect 输出契约",
      "input": "type / required_keys / schema / pattern",
      "output": "pass 或 error / repair",
      "notes": "当前不设 min_chars / max_chars；只挡格式。"
    },
    {
      "id": "v9.knowledge",
      "layer": "v9",
      "type": "Python",
      "name": "Knowledge(path)",
      "input": "SQLite 路径",
      "output": "entities / claims / sources / explored",
      "notes": "长期数据只存知识。"
    },
    {
      "id": "v9.claim",
      "layer": "v9",
      "type": "Python",
      "name": "Knowledge.add_claim(subject, predicate, obj, statement, *, confidence, source_url, derived_from)",
      "input": "关系 + 语句 + 来源/推理链",
      "output": "claim_id",
      "notes": "source_url 与 derived_from 至少一个；不设字数上限。"
    },
    {
      "id": "v9.cycle.step",
      "layer": "v9",
      "type": "Python",
      "name": "CycleEngine.step()",
      "input": "知识库中的未探索实体对",
      "output": "claim / no_relation / rejected",
      "notes": "执行 v8 cycle.json：两路 http → v7 图 → script 入库。"
    },
    {
      "id": "v9.cycle.json",
      "layer": "v9",
      "type": "JSON",
      "name": "一个推理周期",
      "input": "a, b, url_a, url_b（seed）",
      "output": "commit_result",
      "notes": "get_a/get_b → gen(graph) → commit(script)。"
    },
    {
      "id": "v9.derive",
      "layer": "v9",
      "type": "Python",
      "name": "CycleEngine.derive_step()",
      "input": "A→B + B→C",
      "output": "derived claim / no_chain / no_relation",
      "notes": "执行 derive.json；derived_from=[c1,c2]。"
    },
    {
      "id": "v9.derive.json",
      "layer": "v9",
      "type": "JSON",
      "name": "多跳周期",
      "input": "c1_json, c2_json, c1_id, c2_id, a, c",
      "output": "commit_result",
      "notes": "gen(graph) → commit_derived(script)。"
    },
    {
      "id": "v9.expand",
      "layer": "v9",
      "type": "Python",
      "name": "expand(knowledge, fetch, entity, limit=3)",
      "input": "实体 + fetch",
      "output": "新增实体名列表",
      "notes": "Wikipedia prop=links 外链扩展。"
    }
  ],

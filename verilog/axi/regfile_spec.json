{
  "$schema": "apb-regfile-spec/v2",
  "description": "APB 寄存器从机规格 v2 —— 支持位域（fields）定义，由 gen_regfile.py 生成 RTL/测试/手册",
  "module": "apb_slave_regfile_gen",
  "bus": {
    "protocol": "APB",
    "addr_width": 8,
    "data_width": 32,
    "wait_cycles": 2
  },
  "registers": [
    {
      "name": "VERSION",
      "offset": "0x00",
      "attr": "RO",
      "reset": "0x00010203",
      "description": "IP 版本号（只读，整字属性）"
    },
    {
      "name": "INT_STATUS",
      "offset": "0x04",
      "attr": "W1C",
      "reset": "0x00000000",
      "description": "中断状态（整字 W1C）"
    },
    {
      "name": "RESERVED0",
      "offset": "0x08",
      "attr": "RSVD",
      "reset": "0x00000000",
      "description": "保留（整字保留）"
    },
    {
      "name": "CTRL",
      "offset": "0x0C",
      "attr": "RW",
      "reset": "0x00000000",
      "description": "控制寄存器（含位域定义）（位域属性见 fields）",
      "fields": [
        {
          "name": "ENABLE",
          "bits": "0",
          "attr": "RW",
          "reset": 0,
          "description": "模块使能"
        },
        {
          "name": "MODE",
          "bits": "2:1",
          "attr": "RW",
          "reset": 0,
          "description": "工作模式选择"
        },
        {
          "name": "IRQ_EN",
          "bits": "3",
          "attr": "RW",
          "reset": 0,
          "description": "中断使能"
        },
        {
          "name": "RESERVED",
          "bits": "15:4",
          "attr": "RSVD",
          "reset": 0,
          "description": "保留位"
        },
        {
          "name": "STATUS_CODE",
          "bits": "23:16",
          "attr": "RO",
          "reset": 0,
          "description": "状态码（只读）"
        },
        {
          "name": "FLAGS",
          "bits": "31:24",
          "attr": "W1C",
          "reset": 0,
          "description": "事件标志（写 1 清除）"
        }
      ]
    },
    {
      "name": "STATUS",
      "offset": "0x10",
      "attr": "RO",
      "reset": "0x00000011",
      "description": "状态寄存器（整字只读）"
    },
    {
      "name": "INT_ENABLE",
      "offset": "0x14",
      "attr": "RW",
      "reset": "0x00000000",
      "description": "中断使能（整字读写）"
    },
    {
      "name": "DATA_IN",
      "offset": "0x18",
      "attr": "RW",
      "reset": "0x00000000",
      "description": "数据输入"
    },
    {
      "name": "DATA_OUT",
      "offset": "0x1C",
      "attr": "RW",
      "reset": "0x00000000",
      "description": "数据输出"
    },
    {
      "name": "SCRATCH",
      "offset": "0x20",
      "attr": "RW",
      "reset": "0x00000000",
      "description": "暂存寄存器"
    },
    {
      "name": "IRQ_CLEAR",
      "offset": "0x24",
      "attr": "W1C",
      "reset": "0x00000000",
      "description": "中断清除（整字 W1C）"
    }
  ]
}
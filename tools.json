{
  "calculator": {
    "name": "calculator",
    "description": "安全数学表达式计算器，支持加减乘除与括号计算",
    "parameters": {
      "type": "object",
      "properties": {
        "expression": {
          "type": "string",
          "description": "待计算的数学表达式，例如: (5000 - 3200) / 5000 * 100"
        }
      },
      "required": ["expression"]
    },
    "handler": "builtin:eval_math"
  },
  "search_web": {
    "name": "search_web",
    "description": "网络检索与知识库搜索工具",
    "parameters": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "搜索关键词或主题"
        }
      },
      "required": ["query"]
    },
    "handler": "builtin:search"
  },
  "format_json": {
    "name": "format_json",
    "description": "结构化 JSON 格式化与校验工具",
    "parameters": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "description": "待格式化的字典对象"
        }
      },
      "required": ["data"]
    },
    "handler": "builtin:format_json"
  }
}

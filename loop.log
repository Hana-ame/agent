print(f'1. BASIC STATS')
print(f'   Total log entries: {len(lines)}')
print(f'   Date range: 2026-05-17 to 2026-05-24')

# 2. HTTP Methods
methods = {}
for line in lines:
    if 'GET' in line:
        methods['GET'] = methods.get('GET', 0) + 1
    elif 'POST' in line:
        methods['POST'] = methods.get('POST', 0) + 1
print(f'   GET: {methods.get(\"GET\", 0)}')
print(f'   POST: {methods.get(\"POST\", 0)}')

# 3. Status codes
statuses = {}
for line in lines:
    for s in ['200', '201', '204', '301', '302', '304', '400', '401', '403', '404', '500', '502', '503']:
        if f'| {s} |' in line:
            statuses[s] = statuses.get(s, 0) + 1
print(f'   Status codes: {statuses}')

# 4. Endpoints
from collections import Counter
endpoints = Counter()
for line in lines:
    m = __import__('re').search(r'\"(GET|POST)\s+([^\"]+)\"', line)
    if m:
        endpoints[m.group(2)] += 1

print()
print('2. TOP ENDPOINTS')
for ep, count in endpoints.most_common(15):
    print(f'   {ep}: {count}')

# 5. Top IPs
ips = Counter()
for line in lines:
    # Match IP after status code
    parts = line.split('|')
    if len(parts) >= 4:
        ip_part = parts[2].strip()
        if ip_part and not ip_part.startswith(' '):
            ips[ip_part] += 1

print()
print('3. TOP SOURCE IPS')
for ip, count in ips.most_common(15):
    print(f'   {ip}: {count}')

# 6. Board activity
boards = Counter()
for line in lines:
    m = __import__('re').search(r'bid=(\d+)', line)
    if m:
        boards[m.group(1)] += 1
print()
print('4. BOARD ACTIVITY')
for b, c in boards.most_common(10):
    print(f'   Board {b}: {c} requests')

# 7. Suspicious patterns
print()
print('5. SUSPICIOUS PATTERNS')
# pn=99999
pn99999 = sum(1 for l in lines if 'pn=99999' in l)
print(f'   Requests with pn=99999: {pn99999} (likely scanning/brute-force)')

# tid=0 requests

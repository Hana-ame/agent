print(f'   GET requests with tid=0: {tid0}')

# 8. 500 error analysis
print()
print('6. 500 ERROR DETAILS')
error_lines = [l for l in lines if '| 500 |' in l]
print(f'   Total 500 errors: {len(error_lines)}')
error_endpoints = Counter()
error_ips = Counter()
for l in error_lines:
    m = __import__('re').search(r'\"(GET|POST)\s+([^\"]+)\"', l)
    if m:
        error_endpoints[m.group(2)] += 1
    parts = l.split('|')

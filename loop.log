import gzip, json, re
with open('/tmp/task.txt.gz', 'rb') as f:
    data = f.read()
text = gzip.decompress(data).decode('utf-8', errors='replace')

# Analyze the logs
lines = text.split('\n')
print(f'Total lines: {len(lines)}')

# Count request types
cookie_reqs = 0
board_101_reqs = 0
tid_reqs = 0
post_reqs = 0
error_500 = 0
error_404 = 0

# Track unique tids
tids = set()
unique_bid_101_dates = set()
dates = set()

for line in lines:
    if 'GET' in line and '/api/v2/cookie' in line:
        cookie_reqs += 1
    if 'GET' in line and 'bid=101' in line:
        board_101_reqs += 1
    if 'GET' in line and 'tid=' in line:
        m = re.search(r'tid=(\d+)', line)
        if m:
            tids.add(m.group(1))
        tid_reqs += 1
    if 'POST' in line:
        post_reqs += 1
    if '| 500 |' in line:
        error_500 += 1
    if '| 404 |' in line:
        error_404 += 1
    # Date tracking
    m = re.search(r'(\d{4}/\d{2}/\d{2})', line)
    if m:
        dates.add(m.group(1))

print(f'Cookie requests: {cookie_reqs}')
print(f'Board 101 requests: {board_101_reqs}')
print(f'TID requests (all boards): {tid_reqs}')
print(f'Unique TIDs: {len(tids)}')
print(f'POST requests: {post_reqs}')
print(f'500 errors: {error_500}')
print(f'404 errors: {error_404}')
print(f'Dates range: {sorted(dates)}')
print(f'Unique TIDs: {sorted(tids, key=int)[:20]}...')

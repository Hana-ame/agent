    if isinstance(l, list):
        l.sort(key=lambda x: x.get('ts',''), reverse=True)
        for r in l:
            if isinstance(r, dict):
                n = r.get('n','?')
                no = r.get('no','?')
                txt = r.get('txt','')[:100]
                print(f'  REPLY(n={n}, no={no}): {txt}')
    print()

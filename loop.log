import gzip, re
with open('/tmp/task.txt.gz', 'rb') as f:
    data = f.read()
text = gzip.decompress(data).decode('utf-8', errors='replace')

lines = text.split('\n')

# Parse logs
def parse_log(line):
    m = re.match(r'\[GIN\]\s+(\d{4}/\d{2}/\d{2}\s+-\s+\d{2}:\d{2}:\d{2})\s+\|\s+(\d{3})\s+\|\s+([\d.]+(?:µs|ms|s))\s+\|\s+(\S+)\s+\|\s+(GET|POST|PUT|DELETE|HEAD)\s+\"([^\"]+)\"', line)
    if m:
        return {
            'time': m.group(1),
            'status': m.group(2),
            'duration': m.group(3),
            'ip': m.group(4),
            'method': m.group(5),
            'path': m.group(6)
        }
    return None

parsed = [p for p in (parse_log(l) for l in lines) if p]

# Daily activity
from collections import Counter, defaultdict
daily = Counter()
for p in parsed:
    day = p['time'].split(' ')[0]  # YYYY/MM/DD
    daily[day] += 1

print('Daily activity:')
for day, count in sorted(daily.items()):
    print(f'  {day}: {count} requests')

print()

# Board 101 detailed analysis
board101 = [p for p in parsed if 'bid=101' in p['path']]
print(f'Board 101 total requests: {len(board101)}')
board101_ips = Counter(p['ip'] for p in board101)
print('Board 101 top IPs:')
for ip, count in board101_ips.most_common(10):
    print(f'  {ip}: {count}')

print()

# Board 23 detailed analysis
board23 = [p for p in parsed if 'bid=23' in p['path']]
print(f'Board 23 total requests: {len(board23)}')
board23_ips = Counter(p['ip'] for p in board23)
print('Board 23 top IPs:')
for ip, count in board23_ips.most_common(10):
    print(f'  {ip}: {count}')

# Check the first line for server startup
print()
print('First few lines of log:')
for line in lines[:3]:
    print(f'  {line}')
    
# Check the last few lines
print()
print('Last few lines of log:')
for line in lines[-5:]:
    print(f'  {line}')

# Find the most active time period
hourly = Counter()
for p in parsed:
    m = re.search(r'(\d{2}):\d{2}:\d{2}', p['time'])
    if m:
        hourly[m.group(1)] += 1

print()
print('Hourly activity:')
for hour in sorted(hourly.keys()):
    print(f'  {hour}:00 - {hour}:00: {hourly[hour]} requests')
"


import gzip, re
with open('/tmp/task.txt.gz', 'rb') as f:
    data = f.read()
text = gzip.decompress(data).decode('utf-8', errors='replace')

lines = text.split('\n')

from collections import Counter

# Proper log line parsing
# Format: [GIN] 2026/05/24 - 20:25:04 | 200 | 21.716596ms | IP | METHOD \"/path\"
def parse_log(line):
    m = re.match(r'\[GIN\]\s+(\d{4}/\d{2}/\d{2}\s+-\s+\d{2}:\d{2}:\d{2})\s+\|\s+(\d{3})\s+\|\s+([\d.]+(?:µs|ms|s))\s+\|\s+(\S+)\s+\|\s+(GET|POST|PUT|DELETE|HEAD)\s+\"([^\"]+)\"', line)
    if m:
        return {
            'time': m.group(1),
            'status': m.group(2),
            'duration': m.group(3),
            'ip': m.group(4),
            'method': m.group(5),
            'path': m.group(6)
        }
    return None

parsed = [p for p in (parse_log(l) for l in lines) if p]
print(f'Parsed entries: {len(parsed)}')

# Top IPs
ips = Counter(p['ip'] for p in parsed)
print()
print('TOP IPS:')
for ip, count in ips.most_common(20):
    print(f'  {ip}: {count}')

# Top paths
paths = Counter(p['path'] for p in parsed)
print()
print('TOP PATHS:')
for path, count in paths.most_common(20):
    print(f'  {path}: {count}')

# 500 errors
errors = [p for p in parsed if p['status'] == '500']
print()
print(f'500 ERRORS: {len(errors)}')
error_paths = Counter(p['path'] for p in errors)
for path, count in error_paths.most_common(20):
    print(f'  {path}: {count}')

# Board 23 vs Board 101 activity
board23_get = [p for p in parsed if 'bid=23' in p['path'] and p['method'] == 'GET']
board23_post = [p for p in parsed if 'bid=23' in p['path'] and p['method'] == 'POST']
board101_get = [p for p in parsed if 'bid=101' in p['path'] and p['method'] == 'GET']
board101_post = [p for p in parsed if 'bid=101' in p['path'] and p['method'] == 'POST']
print()
print(f'Board 23 GET: {len(board23_get)}, POST: {len(board23_post)}')
print(f'Board 101 GET: {len(board101_get)}, POST: {len(board101_post)}')

# Cookie requests
cookie_reqs = [p for p in parsed if '/api/v2/cookie' in p['path']]
print(f'Cookie requests: {len(cookie_reqs)}')

# TID patterns for scanning
tid_patterns = Counter()
for p in parsed:
    m = re.search(r'tid=(\d+)', p['path'])
    if m:
        tid = m.group(1)
        if len(tid) <= 3 or (len(tid) >= 4 and int(tid) < 10000):
            tid_patterns[tid] += 1

print()
print('SUSPICIOUS TID PATTERNS (likely brute-force scanning):')
for tid, count in tid_patterns.most_common(20):
    print(f'  tid={tid}: {count}')

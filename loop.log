        scan_ips[p['ip']] += 1

print('IPs using pn=99999 (scanning pattern):')
for ip, count in scan_ips.most_common(20):
    print(f'  {ip}: {count}')

print()

# Analyze POST patterns
print('POST request details:')
for p in parsed:
    if p['method'] == 'POST':
        print(f'  {p[\"time\"]} | {p[\"status\"]} | {p[\"ip\"]} | {p[\"path\"]}')

print()

# Analyze the GIN debug startup line
for line in lines:
    if 'GIN-debug' in line:
        print('GIN Debug line:', line)

print()

# Look for unique status codes
status_set = set()
for p in parsed:
    status_set.add(p['status'])
print(f'Unique status codes: {sorted(status_set)}')

# Average response time
durations = []
for p in parsed:
    d = p['duration']
    if d.endswith('µs'):
        durations.append(float(d[:-2]) / 1000)
    elif d.endswith('ms'):
        durations.append(float(d[:-2]))
    elif d.endswith('s'):
        durations.append(float(d[:-1]) * 1000)

if durations:
    print(f'Average response time: {sum(durations)/len(durations):.2f} ms')
    print(f'Max response time: {max(durations):.2f} ms')
    print(f'Min response time: {min(durations):.2f} ms')

# Per-endpoint analysis
endpoint_stats = {}
for p in parsed:
    ep = p['path']
    if ep not in endpoint_stats:
        endpoint_stats[ep] = {'count': 0, 'errors': 0, 'ips': set()}
    endpoint_stats[ep]['count'] += 1
    endpoint_stats[ep]['ips'].add(p['ip'])
    if p['status'] == '500':
        endpoint_stats[ep]['errors'] += 1

print()
print('Endpoint analysis (count, errors, unique IPs):')
for ep, stats in sorted(endpoint_stats.items(), key=lambda x: -x[1]['count'])[:15]:
    print(f'  {ep}: count={stats[\"count\"]}, errors={stats[\"errors\"]}, unique_ips={len(stats[\"ips\"])}')

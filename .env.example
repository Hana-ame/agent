# =============================================================
# Vertex-Edge Agent — Environment Variables
# =============================================================
# Copy this file to `.env`, fill in your real values, and do NOT
# commit the resulting `.env` file to version control.
#
#   cp .env.example .env
#
# .gitignore already excludes `.env` (see .gitignore).
# =============================================================

# --- SenseNova 6.8 Flash Lite (V4 edge) ---
# API key for the SenseNova inference endpoint.
# Required by framework/sensenova_edge_v4.py (SenseNovaEdgeV4).
# Obtain from https://sensenova.moonchan.xyz or your org's console.
SENSENOVA_API_KEY=sk-your-key-here

# --- Generic LLM (OpenCode Zen, OpenAI, etc.) ---
# Used by HttpLLMAgent and the legacy Edge classes.
# OpenCode Zen works with the default "public" key.
LLM_API_KEY=public

# --- Hugging Face (for dataset/model downloads) ---
# Optional. Required only if you download gated HF datasets or models.
HF_TOKEN=

# --- Proxy (optional) ---
# Transport-level HTTP(S) proxy for LLM API calls.
# Leave empty for direct connections.
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890

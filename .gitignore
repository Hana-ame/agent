# =====================================================================
# 本仓库的忽略规则
#   本地垃圾清理：scripts/clean-local.sh（默认只列不删）
#   仓库结构导航：README.md
# =====================================================================

# ---- Python 通用产物（全部可再生）-----------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.coverage
htmlcov/

# ---- 环境与密钥 ------------------------------------------------------
.env
.env.local
*.env
.venv
env/
venv/
ENV/

# 含真实 key 的模型配置不入库；只保留模板与 scripts/cf 的免 Key 网关配置
models.json
models.json*.bak
!models.json.example
!scripts/cf/models.json

# ---- 脚本运行产物 ----------------------------------------------------
# S1 帖子抓取与情报摘要
scripts/s1/out/
stage1st_ai_*.md
stability_run*.md
# CF 流量统计与校验
scripts/cf/cf_report.md
cf_report.md
# 各 DAG 运行报告（reports/ 下少数结论文件显式保留）
*_report.md
!reports/session_*_report.md
# 其他临时输出与日志
out/
report.html
*.report.html
*.log
*.db
scratch/

# ---- 各层运行数据（本地可再生成，不入库）-----------------------------
# dag8 SQLite 轨迹
v8/data/
# v9 知识库
v9/data/
# v6 自举历史产物（留档，不跟踪）
bootstrap_runs/
# 本地工作记忆/决策记录（尚未入库，见 README 第 9 节）
.workbuddy/
# 本地截图
/browser-screenshots/

# ---- 本地一次性脚本与模型快照（可删；见 scripts/clean-local.sh）-----
/.fix_example.py
/.gen_models.py
/.models_new.*
/.probe_cap.py
/.verify_cap.py
